# CIIS School Intelligence AI - Environment Configuration
# Copy to .env and fill in real values for production

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (SQLite for demo, MySQL for production)
DATABASE_URL=sqlite:///./ciis_ai.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ciis_ai

# CIIS Integration
CIIS_BASE_URL=http://localhost:8080
CIIS_SERVICE_TOKEN=change-this-to-service-token

# Model Configuration
MODEL_DIR=./models
MODEL_MIN_SAMPLES=50
MODEL_ACCEPTANCE_F1=0.5
MODEL_RANDOM_SEED=42

# Security
API_KEY=change-this-to-api-key
CORS_ORIGINS=http://localhost:8080
MAX_REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ciis_ai.log
# Never log sensitive student data
LOG_SENSITIVE_DATA=false
